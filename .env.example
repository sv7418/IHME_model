# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose one: anthropic | groq | ollama | mock
LLM_PROVIDER=anthropic

# ── Anthropic (best quality) ──────────────────────────────────────────────────
# Required when LLM_PROVIDER=anthropic
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_key_here

# ── Groq (free tier, fast, no credit card) ────────────────────────────────────
# Required when LLM_PROVIDER=groq
# 1. Sign up free at https://console.groq.com (no credit card)
# 2. Create an API key and paste it below
# 3. Set LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.1-70b-versatile
# Other good Groq models: mixtral-8x7b-32768  |  llama3-70b-8192

# ── Ollama (fully local, no internet after setup) ─────────────────────────────
# Required when LLM_PROVIDER=ollama
# 1. Install: https://ollama.com
# 2. Pull:    ollama pull llama3.1
# 3. Run:     ollama serve
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# ── Mock mode (UI testing, zero setup) ───────────────────────────────────────
# Streams a pre-written T2D sample report — no API key or network needed.
# Either set LLM_PROVIDER=mock  OR  MOCK_MODE=true
MOCK_MODE=false

# ── Optional: NCBI API key ────────────────────────────────────────────────────
# Raises PubMed rate limit from 3 → 10 req/s
# Get one at https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

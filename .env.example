# Anthropic API key — required for real AI analysis.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_key_here

# Set to true to run without any API key.
# Streams a pre-written Type 2 Diabetes sample report so you can test the UI.
MOCK_MODE=false

# Optional: NCBI API key for higher PubMed rate limits (10 req/s vs 3 req/s)
# Get one at https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

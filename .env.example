# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose one: anthropic | ollama | mock
LLM_PROVIDER=anthropic

# ── Anthropic (default) ───────────────────────────────────────────────────────
# Required when LLM_PROVIDER=anthropic
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_key_here

# ── Ollama (local, free, no API key) ─────────────────────────────────────────
# Required when LLM_PROVIDER=ollama
# 1. Install Ollama:  https://ollama.com
# 2. Pull a model:    ollama pull llama3.1
# 3. Set provider:    LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# ── Mock mode (UI testing, no network required) ───────────────────────────────
# Streams a pre-written T2D sample report through the full UI pipeline.
# Either set LLM_PROVIDER=mock  OR  MOCK_MODE=true
MOCK_MODE=false

# ── Optional: NCBI API key ────────────────────────────────────────────────────
# Raises PubMed rate limit from 3 → 10 req/s
# Get one at https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=
